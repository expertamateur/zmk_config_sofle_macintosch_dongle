/ {
    chosen {
        zmk,trackpad_led = &trackpad_led;
        zmk,custom_led=&custom_led;
    };
    trackpad_led: pwmledo{
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm1 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };
    
    custom_led: pwmledto{
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm3 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;
    pinctrl-1 = <&pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    clock-frequency = <I2C_BITRATE_FAST>; 
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    bbtrackpad:a320@3B {
        compatible = "avago,a320";
        reg = <0x3B>;
        status = "okay";
    };
    
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        bbtrackpad_split: bbtrackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };

    };

    /* Listeners */
    bbtrackpad_listener: bbtrackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&bbtrackpad_split>;
    };

};


&bbtrackpad_split {
    device = <&bbtrackpad>;
};

/*
 * 引脚定义在 config/sofle_dongle_left.overlay（属于板子，不属于模块）。
 *
 * 注意 pwm3 的 enable 也在那个文件里，不在这里：pwm3 是插座上那颗副 LED，
 * 只有左板把它接出来了。enable 里引用 pwm3_default，而 pwm3_default 是板级
 * 引脚 —— 放在 shield 里会让右板在设备树阶段就报
 * "undefined node label 'pwm3_default'"，掩盖掉本来该看到的
 * 「右座没有触摸板引脚」那条 #error。同理，将来若某侧缺插座引脚，
 * enable 也该跟着引脚走在板级 overlay 里。
 */

