#
# 五块板 = 「半别 × 角色」：
#   dongle_master  独立的 dongle，当中央（有 dongle 的那套接线）
#   lf_/rt_slaver  左/右半当外设（挂在 dongle 或对侧主控下面）
#   lf_/rt_master  左/右半当主控（没有 dongle 时自己连主机）
# 角色带来的差异见 Kconfig.defconfig，硬件差异见 lf.dtsi / rt.dtsi。

config BOARD_DONGLE_MASTER
    bool "sofle dongle (dongle, central)"
    depends on SOC_NRF52840_QIAA

config BOARD_LF_SLAVER
    bool "sofle dongle left half (peripheral)"
    depends on SOC_NRF52840_QIAA

config BOARD_LF_MASTER
    bool "sofle dongle left half (central, no dongle)"
    depends on SOC_NRF52840_QIAA

config BOARD_RT_SLAVER
    bool "sofle dongle right half (peripheral)"
    depends on SOC_NRF52840_QIAA

config BOARD_RT_MASTER
    bool "sofle dongle right half (central, no dongle)"
    depends on SOC_NRF52840_QIAA

menu "A320 Trackpad Setting"

config A320_TRACKPAD_SCROLL_INTERVAL
    int "Trackpad scroll in miliseconds"
    default 50
    range 0 200
    help
      The bigger this value, the slower the trackpad scrolls

config A320_LOG_LEVEL
	int "Log Level for Touch"
	default 4

config A320
	bool "A320 Driver"
	depends on I2C && GPIO
	help
	  Projected capacitive trackpad/touchscreen controller.

config INPUT_A320_INIT_PRIORITY
  int "A320 Initialization Priority"
  default 90

endmenu
