/*
 * 左半（左手）的硬件：kscan 矩阵、EXT_POWER、编码器、屏幕 SPI、模块插座引脚。
 *
 * Copyright (c) 2025 ZitaoTech
 * SPDX-License-Identifier: MIT
 *
 * 被 lf_slaver.dts / lf_master.dts 包含 —— 两侧角色（外设/中央）的硬件完全相同，
 * 差别只在角色：外设侧不用加东西，中央侧由 lf_master.dts 补「对侧模块走 split
 * 入站」的节点。67 格变换表、编码器、传感器、USB 串口、flash 分区在
 * sofle_dongle.dtsi 里（五块板共用）。
 */

#include "sofle_dongle.dtsi"


/ {
    chosen {
        zmk,backlight = &backlight;
        zmk,battery = &vbatt;
        zmk,underglow = &led_strip;
        zmk,keyboard_backlight = &keyboard_backlight;
    };
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 15  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 13  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 26  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio0 19  GPIO_ACTIVE_HIGH>
            , <&gpio0 23  GPIO_ACTIVE_HIGH>
            , <&gpio0 25  GPIO_ACTIVE_HIGH>
            , <&gpio1 0 GPIO_ACTIVE_HIGH>
            , <&gpio0 24 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio0 8 GPIO_ACTIVE_HIGH>
            , <&gpio0 6 GPIO_ACTIVE_HIGH>
            ;
    };


    keyboard_backlight: pwmledfo{
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_USEC(2000) PWM_POLARITY_NORMAL>;
        };
    };

    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm2 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };
    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
    };
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 0>;
        output-ohms = <2000000>;
        full-ohms = <2820000>;  // 2000000 + 820000
    };
};

&default_transform {
    col-offset = <1>;
};


&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&spi2 {
    status = "okay";
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm2 {
    status = "okay";
    pinctrl-0 = <&pwm2_default>;
    pinctrl-1 = <&pwm2_sleep>;
    pinctrl-names = "default", "sleep";
};

&left_encoder {
    status = "okay";
};



lpm_view_spi: &spi2 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >;
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <400000>;
        /* WS2812 */
        chain-length = <1>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

&pinctrl {
    pwm0_default:pwm0_default{
        group1{
            psels = <NRF_PSEL(PWM_OUT0, 1, 10)>; // keyboard backlight
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 10)>;
            bias-pull-down;
        };
    };

   pwm2_default: pwm2_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 9)>; // backlight unreal
        };
    };

    pwm2_sleep: pwm2_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 9)>;
            bias-pull-down;
        };
    };    
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 14)>,
            <NRF_PSEL(SPIM_SCK, 0, 11)>;
        };
    };
    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 14)>,
            <NRF_PSEL(SPIM_SCK, 0, 11)>;
            low-power-enable;
        };
    };
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;    // Setting for RGB light, unreal
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

/* =========================================================================
 * 模块插座（左座）的引脚：插座上的哪根线接到左板 MCU 的哪只脚。
 *
 * 属于板子、不属于模块（见 MODULAR_POINTER_ANALYSIS.md §4.1）：
 *   轨迹球 UP   P0.05  =  触摸板 MOTION
 *   轨迹球 LEFT P0.12  =  触摸板 I2C SCL
 *   轨迹球 DOWN P1.09  =  触摸板 I2C SDA
 *   轨迹球 RIGHT P0.27 =  （触摸板不用）
 *
 * shield 那边只负责把外设 enable 起来（&pwm1 / &pwm3 / &i2c0），引脚本身在
 * 这里单点定义，换模块不用动。引脚号（Kconfig 那半）在 Kconfig.defconfig 里，
 * 按「半」给默认值：同侧的 master/slaver 硬件相同，共享一份。
 * ========================================================================= */
&pinctrl {
    /* 模块主 LED：轨迹球和触摸板共用同一颗 */
    pwm1_default: pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 7)>;
        };
    };

    pwm1_sleep: pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 7)>;
            bias-pull-down;
        };
    };

    /* 触摸板自己加的那颗 LED —— 只有左板引出来了。enable 也一并留在这边
     * 而不是 shield 里（bbtrackpad.overlay 引用了 pwm3_default，放 shield
     * 会让右板在设备树阶段就炸，见那边的注释） */
    pwm3_default: pwm3_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 16)>;
        };
    };

    pwm3_sleep: pwm3_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 16)>;
            bias-pull-down;
        };
    };

    /* 模块插座上的 I2C，只有触摸板会用（轨迹球拿这两根当方向线） */
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 12)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 12)>;
            low-power-enable;
        };
    };
};

/* 触摸板副 LED 的 enable：插触摸板才有消费者，插轨迹球时这里只是留一个
 * 没人用的 PWM 设备（开销可忽略）。 */
&pwm3 {
    status = "okay";
    pinctrl-0 = <&pwm3_default>;
    pinctrl-1 = <&pwm3_sleep>;
    pinctrl-names = "default", "sleep";
};
